+get_sta_freq_list() {
+	local phy=$1
+	local radio_id=$2
+	local band_name=$3
+
+	[ "$radio_id" = "-1" ] && return ""
+
+	freq_range=$(iw $phy info | grep -A 1 "Idx $radio_id:" | grep "Frequency Range:" | awk '{print $3, $6}')
+	set -- $freq_range
+	freq1=$1
+	freq2=$2
+
+        case "$band_name" in
+                2g) band="1:";;
+                5gl|5gh|5g) band="2:";;
+                60g) band="3:";;
+                6g|6gl|6gh) band="4:";;
+        esac
+
+	iw "$phy" info | awk -v band="$band" -v min="$freq1" -v max="$freq2" '
+
+$1 ~ /Band/ {
+        band_match = band == $2
+}
+
+band_match && $3 == "MHz" {
+        freq = $2
+         if (freq >= min && freq <= max) {
+                print int($2)
+        }
+}
+' | tr '\n' ' '
+}
