From 938a7c7b0d86c58c2312299c13a8b9c6f6bc036c Mon Sep 17 00:00:00 2001
From: Haritha Muthukumar <hmuthuku@qti.qualcomm.com>
Date: Thu, 4 Sep 2025 11:29:28 +0530
Subject: [PATCH] ethtool: fix MDI-X showing as Unknown instead of "off (auto)"

Change-Id: Ib77cf0cfce34fc0b82450d4ffa0d9707d0eaf7db
Signed-off-by: Haritha Muthukumar <hmuthuku@qti.qualcomm.com>
---
 ...building-for-RSS-input-xfrm-optional.patch | 25 ++++++++++++++++---
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/package/network/utils/ethtool/patches/0001-ethtool-make-building-for-RSS-input-xfrm-optional.patch b/package/network/utils/ethtool/patches/0001-ethtool-make-building-for-RSS-input-xfrm-optional.patch
index 4c8403dcbc5d..ae23fa6cf054 100644
--- a/package/network/utils/ethtool/patches/0001-ethtool-make-building-for-RSS-input-xfrm-optional.patch
+++ b/package/network/utils/ethtool/patches/0001-ethtool-make-building-for-RSS-input-xfrm-optional.patch
@@ -16,8 +16,10 @@ Signed-off-by: Daniel Golle <daniel@makrotopia.org>
  ethtool.c    | 10 ++++++++++
  2 files changed, 20 insertions(+)
 
---- a/configure.ac
-+++ b/configure.ac
+Index: ethtool-6.11/configure.ac
+===================================================================
+--- ethtool-6.11.orig/configure.ac
++++ ethtool-6.11/configure.ac
 @@ -45,6 +45,16 @@ if test x$enable_pretty_dump = xyes; the
  fi
  AM_CONDITIONAL([ETHTOOL_ENABLE_PRETTY_DUMP], [test x$enable_pretty_dump = xyes])
@@ -35,8 +37,10 @@ Signed-off-by: Daniel Golle <daniel@makrotopia.org>
  AC_ARG_WITH([bash-completion-dir],
  	    AS_HELP_STRING([--with-bash-completion-dir[=PATH]],
  	                   [Install the bash-completion script in this directory. @<:@default=yes@:>@]),
---- a/ethtool.c
-+++ b/ethtool.c
+Index: ethtool-6.11/ethtool.c
+===================================================================
+--- ethtool-6.11.orig/ethtool.c
++++ ethtool-6.11/ethtool.c
 @@ -4109,9 +4109,11 @@ static int do_grxfh(struct cmd_context *
  		       (const char *)hfuncs->data + i * ETH_GSTRING_LEN,
  		       (rss->hfunc & (1 << i)) ? "on" : "off");
@@ -65,3 +69,16 @@ Signed-off-by: Daniel Golle <daniel@makrotopia.org>
  	if (delete) {
  		rss->indir_size = rss->key_size = 0;
  	} else {
+Index: ethtool-6.11/common.c
+===================================================================
+--- ethtool-6.11.orig/common.c
++++ ethtool-6.11/common.c
+@@ -171,6 +171,8 @@ void dump_mdix(u8 mdix, u8 mdix_ctrl)
+ 		mdi_x_forced = true;
+ 	} else {
+ 		switch (mdix) {
++		case ETH_TP_MDI:
++			break;
+ 		case ETH_TP_MDI_X:
+ 			mdi_x = true;
+ 			break;
-- 
2.34.1

