From 684f2b46654e00e73eb93ec20cb79d22c02a7802 Mon Sep 17 00:00:00 2001
From: Deepak Kumar <quic_deepaku@quicinc.com>
Date: Fri, 3 Jan 2025 17:24:38 +0530
Subject: [PATCH] Fix symlink error installation in ppp

Change-Id: Ic61bd45d5eed62710ae594faa83d397c6cdeb663
Signed-off-by: Deepak Kumar <quic_deepaku@quicinc.com>
---
 package/network/services/ppp/Makefile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/package/network/services/ppp/Makefile b/package/network/services/ppp/Makefile
index 6d5db5c70405..4e3e5e856a91 100644
--- a/package/network/services/ppp/Makefile
+++ b/package/network/services/ppp/Makefile
@@ -220,7 +220,9 @@ define Package/ppp/install
 	$(INSTALL_DIR) $(1)/usr/sbin
 	$(INSTALL_BIN) $(PKG_INSTALL_DIR)/sbin/pppd $(1)/usr/sbin/
 	$(INSTALL_DIR) $(1)/etc/ppp
+ifeq ($(CONFIG_OPENSYNC_SUPPORTED),)
 	$(INSTALL_CONF) ./files/etc/ppp/chap-secrets $(1)/etc/ppp/
+endif
 	$(INSTALL_DATA) ./files/etc/ppp/filter $(1)/etc/ppp/
 	$(INSTALL_DATA) ./files/etc/ppp/options $(1)/etc/ppp/
 	$(LN) /tmp/resolv.conf.ppp $(1)/etc/ppp/resolv.conf
-- 
2.34.1

