From 28df99bd67d9daa119562635ff79027ffd818a8b Mon Sep 17 00:00:00 2001
From: Aravind Mosam <amosam@qti.qualcomm.com>
Date: Sat, 21 Sep 2024 19:11:13 +0530
Subject: [PATCH] qsdk: support kernel-6.6.3 subversion

Signed-off-by: Aravind Mosam <amosam@qti.qualcomm.com>
---
 include/kernel-6.6                        | 4 ++--
 package/kernel/linux/modules/netfilter.mk | 2 ++
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/include/kernel-6.6 b/include/kernel-6.6
index 5fbb10e0524f..3f93ad37f99e 100644
--- a/include/kernel-6.6
+++ b/include/kernel-6.6
@@ -1,2 +1,2 @@
-LINUX_VERSION-6.6 = .83
-LINUX_KERNEL_HASH-6.6.83 = 894bbbe63b7484a0bc576a1e11a8dbc090fbd476d6424431bdc8435e03c2c208
+LINUX_VERSION-6.6 = .47
+LINUX_KERNEL_HASH-6.6.47 = d43376c9e9eaa92bb1b926054bd160d329c58a62d64bd65fe1222c11c6564f50
diff --git a/package/kernel/linux/modules/netfilter.mk b/package/kernel/linux/modules/netfilter.mk
index 3cf63982ba44..41cc7cb773fa 100644
--- a/package/kernel/linux/modules/netfilter.mk
+++ b/package/kernel/linux/modules/netfilter.mk
@@ -110,6 +110,7 @@ define KernelPackage/nf-conntrack
 	$(KCONFIG_NF_CONNTRACK)
   FILES:=$(foreach mod,$(NF_CONNTRACK-m),$(LINUX_DIR)/net/$(mod).ko)
   AUTOLOAD:=$(call AutoProbe,$(notdir $(NF_CONNTRACK-m)))
+  DEPENDS:=+kmod-pptp +kmod-lib-crc32c
 endef
 
 define KernelPackage/nf-conntrack/install
@@ -327,6 +328,7 @@ $(eval $(call KernelPackage,ipt-offload))
 
 define KernelPackage/ipt-ipopt
   TITLE:=Modules for matching/changing IP packet options
+  DEPENDS:=+kmod-nf-conntrack
   KCONFIG:=$(KCONFIG_IPT_IPOPT)
   FILES:=$(foreach mod,$(IPT_IPOPT-m),$(LINUX_DIR)/net/$(mod).ko)
   AUTOLOAD:=$(call AutoProbe,$(notdir $(IPT_IPOPT-m)))
-- 
2.34.1

