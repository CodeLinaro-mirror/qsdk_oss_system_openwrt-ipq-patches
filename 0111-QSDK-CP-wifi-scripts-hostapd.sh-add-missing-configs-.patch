+			set_default sae_pwe 2
+		;;
 	esac
+
+	#rsn override used for sae encryption only
+	[ -n "$rsn_override_key_mgmt" ] && {
+		set_default ieee80211w 1
+		set_default sae_pwe 2
+		set_default rsn_override_mfp 1
