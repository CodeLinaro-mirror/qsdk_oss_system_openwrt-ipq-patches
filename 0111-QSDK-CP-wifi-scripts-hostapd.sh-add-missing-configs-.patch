From d3f39800330338d9e190090bba5651476b3102e7 Mon Sep 17 00:00:00 2001
From: Sathishkumar Muruganandam <quic_murugana@quicinc.com>
Date: Fri, 29 Nov 2024 16:14:52 +0530
Subject: [PATCH] QSDK: CP: wifi-scripts: hostapd.sh: add missing configs back

Cleanup the whitespace errors and add missing configs like SAE
wpa_key_mgmt, apup, radius_server_clients back.

Change-Id: Ia9e331a0446235b6dcd43a0bf1be18c4edcb7f86
Signed-off-by: Sathishkumar Muruganandam <quic_murugana@quicinc.com>
---
 .../wifi-scripts/files/lib/netifd/hostapd.sh  | 403 ++++++++++--------
 1 file changed, 217 insertions(+), 186 deletions(-)

diff --git a/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh b/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh
index 233951603add..b3a8c093c849 100644
--- a/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh
+++ b/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh
@@ -5,14 +5,14 @@ wpa_supplicant_add_rate() {
 	local var="$1"
 	local val="$(($2 / 1000))"
 	local sub="$((($2 / 100) % 10))"
-	append $var "$val" ","
-	[ $sub -gt 0 ] && append $var "."
+	append "$var" "$val" ","
+	[ $sub -gt 0 ] && append "$var" "."
 }
 
 hostapd_add_rate() {
 	local var="$1"
 	local val="$(($2 / 100))"
-	append $var "$val" " "
+	append "$var" "$val" " "
 }
 
 hostapd_append_wep_key() {
@@ -24,21 +24,22 @@ hostapd_append_wep_key() {
 		[1234])
 			for idx in 1 2 3 4; do
 				local zidx
-				zidx="$(($idx - 1))"
+				zidx="$((idx - 1))"
 				json_get_var ckey "key${idx}"
 				[ -n "$ckey" ] && \
-					append $var "wep_key${zidx}=$(prepare_key_wep "$ckey")" "$N$T"
+					append "$var" "wep_key${zidx}=$(prepare_key_wep "$ckey")" "$N$T"
 			done
 			wep_keyidx="$((key - 1))"
 		;;
 		*)
-			append $var "wep_key0=$(prepare_key_wep "$key")" "$N$T"
+			append "$var" "wep_key0=$(prepare_key_wep "$key")" "$N$T"
 		;;
 	esac
 }
 
 hostapd_append_wpa_key_mgmt() {
-	local auth_type_l="$(echo $auth_type | tr 'a-z' 'A-Z')"
+	local auth_type_l
+	auth_type_l="$(echo "$auth_type" | tr 'a-z' 'A-Z')"
 
 	case "$auth_type" in
 		psk|eap)
@@ -50,6 +51,11 @@ hostapd_append_wpa_key_mgmt() {
 			append wpa_key_mgmt "WPA-EAP-SUITE-B-192"
 			[ "${ieee80211r:-0}" -gt 0 ] && append wpa_key_mgmt "FT-EAP-SHA384"
 		;;
+		eap-eap2)
+			append wpa_key_mgmt "WPA-EAP"
+			append wpa_key_mgmt "WPA-EAP-SHA256"
+			[ "${ieee80211r:-0}" -gt 0 ] && append wpa_key_mgmt "FT-EAP"
+		;;
 		eap-eap192)
 			append wpa_key_mgmt "WPA-EAP-SUITE-B-192"
 			append wpa_key_mgmt "WPA-EAP"
@@ -57,14 +63,8 @@ hostapd_append_wpa_key_mgmt() {
 				append wpa_key_mgmt "FT-EAP-SHA384"
 				append wpa_key_mgmt "FT-EAP"
 			}
-
 			[ "${ieee80211w:-0}" -gt 0 ] && append wpa_key_mgmt "WPA-EAP-SHA256"
 		;;
-		eap-eap2)
-			append wpa_key_mgmt "WPA-EAP"
-			append wpa_key_mgmt "WPA-EAP-SHA256"
-			[ "${ieee80211r:-0}" -gt 0 ] && append wpa_key_mgmt "FT-EAP"
-		;;
 		eap2)
 			[ "${ieee80211r:-0}" -gt 0 ] && append wpa_key_mgmt "FT-EAP"
 			append wpa_key_mgmt "WPA-EAP-SHA256"
@@ -83,16 +83,15 @@ hostapd_append_wpa_key_mgmt() {
 		owe)
 			append wpa_key_mgmt "OWE"
 		;;
-                sae-ext-key)
-                        append wpa_key_mgmt "SAE-EXT-KEY"
-                ;;
-                ft-sae-ext-key)
-                        append wpa_key_mgmt "FT-SAE-EXT-KEY"
-                ;;
-                dpp)
-                        append wpa_key_mgmt "DPP"
-                ;;
-
+		sae-ext-key)
+			append wpa_key_mgmt "SAE-EXT-KEY"
+		;;
+		ft-sae-ext-key)
+			append wpa_key_mgmt "FT-SAE-EXT-KEY"
+		;;
+		dpp)
+			append wpa_key_mgmt "DPP"
+		;;
 	esac
 
 	[ "$fils" -gt 0 ] && {
@@ -172,17 +171,17 @@ hostapd_prepare_device_config() {
 	set_default airtime_mode 0
 	set_default cell_density 0
 
-        [ -n "$country" ] && [ "$country" != "00" ] && {
-                append base_cfg "country_code=$country" "$N"
-                [ -n "$country3" ] && append base_cfg "country3=$country3" "$N"
+	[ -n "$country" ] && [ "$country" != "00" ] && {
+		append base_cfg "country_code=$country" "$N"
+		[ -n "$country3" ] && append base_cfg "country3=$country3" "$N"
 
-                [ "$country_ie" -gt 0 ] && {
-                        append base_cfg "ieee80211d=1" "$N"
-                        [ -n "$local_pwr_constraint" ] && append base_cfg "local_pwr_constraint=$local_pwr_constraint" "$N"
-                        [ "$spectrum_mgmt_required" -gt 0 ] && append base_cfg "spectrum_mgmt_required=$spectrum_mgmt_required" "$N"
-                }
-                ([ "$hwmode" = "a" ] && [ "$doth" -gt 0 ]) && append base_cfg "ieee80211h=1" "$N"
-        }
