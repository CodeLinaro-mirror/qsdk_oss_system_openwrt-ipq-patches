From c9bc41e9dcf6e6a41fb932f60482ed85cd99f48a Mon Sep 17 00:00:00 2001
From: ` <quic_ratchaya@quicinc.com>
Date: Wed, 31 Jul 2024 12:07:36 +0530
Subject: [PATCH] feeds: Add support for fetching feeds from mirror

In case of failure to fetch from one url, try for other urls
in feeds.conf
Add the support via option -b

Signed-off-by: ` <quic_ratchaya@quicinc.com>
Change-Id: I3a4202255c0a45752f442f4d6fa120d4bd7a195d
---
 include/toplevel.mk |  2 +-
 scripts/feeds       | 12 +++++++++---
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/include/toplevel.mk b/include/toplevel.mk
index 658d30e414f6..594beb68ea32 100644
--- a/include/toplevel.mk
+++ b/include/toplevel.mk
@@ -263,7 +263,7 @@ endif
 
 # update all feeds, re-create index files, install symlinks
 package/symlinks:
-	./scripts/feeds update -a
+	./scripts/feeds update -a -b
 	./scripts/feeds install -a -f
 
 # re-create index files, install symlinks
diff --git a/scripts/feeds b/scripts/feeds
index b5b943c70bf7..c2c46dc92db2 100755
--- a/scripts/feeds
+++ b/scripts/feeds
@@ -776,12 +776,13 @@ sub uninstall {
 	return 0;
 }
 
-sub update_feed($$$$)
+sub update_feed($$$$$)
 {
 	my $type=shift;
 	my $name=shift;
 	my $src=shift;
 	my $force_update=shift;
+	my $fallback=shift;
 	my $force_relocate=update_location( $name, "@$src" );
 	my $rv=0;
 
@@ -803,6 +804,10 @@ sub update_feed($$$$)
 				warn "failed, ignore.\n";
 				next;
 			}
+			if ($fallback) {
+				warn "Failed to  fetch '$name' from '$feedsrc', trying next \n";
+				next;
+			}
 			last;
 		}
 		$failed = 0;
@@ -822,7 +827,7 @@ sub update {
 	$ENV{SCAN_COOKIE} = $$;
 	$ENV{OPENWRT_VERBOSE} = 's';
 
-	getopts('ahif', \%opts);
+	getopts('ahifb', \%opts);
 	%argv_feeds = map { $_ => 1 } @ARGV;
 
 	if ($opts{h}) {
@@ -839,7 +844,7 @@ sub update {
 		my ($type, $name, $src) = @$feed;
 		next unless $#ARGV == -1 or $opts{a} or $argv_feeds{$name};
 		if (not $opts{i}) {
-			update_feed($type, $name, $src, $opts{f}) == 0 or $failed=1;
+			update_feed($type, $name, $src, $opts{f}, $opts{b}) == 0 or $failed=1;
 		}
 		push @index_feeds, $name;
 	}
@@ -906,6 +911,7 @@ Commands:
 	    -a :           Update all feeds listed within feeds.conf. Otherwise the specified feeds will be updated.
 	    -i :           Recreate the index only. No feed update from repository is performed.
 	    -f :           Force updating feeds even if there are changed, uncommitted files.
+	    -b :           Support fetching from mirrors
 
 	clean:             Remove downloaded/generated files.
 
-- 
2.34.1

