-+		rtw_write8(rtwdev, REG_RFE_CTRL8,
-+			   share_ant ? PTA_CTRL_PIN : DPDT_CTRL_PIN);
-+		rtw_write32_mask(rtwdev, REG_RFE_CTRL8, 0x30000000, 0x1);
