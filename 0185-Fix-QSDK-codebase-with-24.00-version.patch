-+		rtw_write8(rtwdev, REG_RFE_CTRL8, DPDT_CTRL_PIN);
-+		rtw_write32_mask(rtwdev, REG_RFE_CTRL8, 0x30000000,
-+				 share_ant ? 0x2 : 0x1);
-+		break;
-+	default:
