From 0fbd478743e0a2eb08ca1aa0043f2e244e7eab66 Mon Sep 17 00:00:00 2001
From: Karthik T S <quic_kartikts@quicinc.com>
Date: Wed, 8 May 2024 15:47:29 +0530
Subject: [PATCH] [nat46] Copy Module symvers from nat46 directory to kernel
 directory

Change-Id: Ie5d4e31a576c727b3b2e40652eef0d6fed8dfe9f
Signed-off-by: Karthik T S <quic_kartikts@quicinc.com>
(cherry picked from commit 4c3e221e054eef4deae77376667ff5a09160b58c)
---
 package/kernel/nat46/Makefile | 1 +
 1 file changed, 1 insertion(+)

diff --git a/package/kernel/nat46/Makefile b/package/kernel/nat46/Makefile
index 296ef5a058e8..2de2484e7d4f 100644
--- a/package/kernel/nat46/Makefile
+++ b/package/kernel/nat46/Makefile
@@ -30,6 +30,7 @@ define Build/Compile
 		MODFLAGS="-DMODULE -mlong-calls" \
 		EXTRA_CFLAGS="-DNAT46_VERSION=\\\"$(PKG_SOURCE_VERSION)\\\"" \
 		modules
+	cp $(PKG_BUILD_DIR)/nat46/modules/Module.symvers $(PKG_BUILD_DIR)/Module.symvers.tmp
 endef
 
 $(eval $(call KernelPackage,nat46))
-- 
2.34.1

