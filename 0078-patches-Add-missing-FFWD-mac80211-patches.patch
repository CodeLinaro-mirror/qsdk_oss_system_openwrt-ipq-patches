+ 	RX_FLAG_AMPDU_DETAILS		= BIT(9),
+ 	RX_FLAG_PN_VALIDATED		= BIT(10),
+@@ -1445,8 +1448,10 @@ enum mac80211_rx_flags {
+ 	RX_FLAG_AMPDU_IS_LAST		= BIT(13),
+ 	RX_FLAG_AMPDU_DELIM_CRC_ERROR	= BIT(14),
+ 	RX_FLAG_AMPDU_DELIM_CRC_KNOWN	= BIT(15),
