++#define HAL_RX_PPDU_END_USER_STATS_INFO8_MPDU_ERR_BYTE_COUNT	GENMASK(24, 0)
+ 
+ struct hal_rx_ppdu_end_user_stats {
+ 	__le32 rsvd0[2];
+@@ -236,7 +236,12 @@ struct hal_rx_ppdu_end_user_stats {
+ 	__le32 info4;
+ 	__le32 info5;
+ 	__le32 info6;
+-	__le32 rsvd2[11];
++	__le32 rsvd2[5];
++	__le32 info7;
++	__le32 rsvd3;
++	__le32 info8;
++	__le32 rsvd3[2];
