Change-Id: Ic59c7d1ede4e3dc4d509ebe8891a97613da505a4
Signed-off-by: Maharaja Kennadyrajan <quic_mkenna@quicinc.com>
---
 package/network/config/wifi-scripts/files/sbin/wifi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/package/network/config/wifi-scripts/files/sbin/wifi b/package/network/config/wifi-scripts/files/sbin/wifi
index 11d1f964d35f..a8d36b5a7412 100755
--- a/package/network/config/wifi-scripts/files/sbin/wifi
+++ b/package/network/config/wifi-scripts/files/sbin/wifi
@@ -6,7 +6,7 @@
 
 usage() {
 	cat <<EOF
-Usage: $0 [config|up|down|reconf|reload|status|isup|mlo_add_link <phy> <band> <interface-name> <vap-mac-addr>]
+Usage: $0 [config|up|down|reconf|reload|status|isup|mlo_add_link <phy> <band> <interface-name> <vap-mac-addr>|mlo_remove_link <phy> <band> <interface-name> <link_id> <removal_timer(5-50)]
 enables (default), disables or configures devices not yet configured.
 EOF
 	exit 1
@@ -364,6 +364,7 @@ case "$1" in
 	recover) wifi_recover "$2";;
 	mlo) mlo "$@";;
 	mlo_add_link) mlo_add_link "$2" "$3" "$4" "$5";;
+	mlo_remove_link) mlo_remove_link "$2" "$3" "$4" "$5" "$6";;
 	standby) standby_wifi_radio_updown "$@" ;;
         multi_up|\
         multi_down) [ "$DISABLE_NET_RELOAD" == "1" ] || multi_radio_wifi_updown "$@";;
