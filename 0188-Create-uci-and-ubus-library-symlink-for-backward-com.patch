From ddc4f5067df57daf9e09af298236dfc0bc0d5a3a Mon Sep 17 00:00:00 2001
From: Deepak Kumar <deepaku@qti.qualcomm.com>
Date: Tue, 5 Aug 2025 19:10:28 +0530
Subject: [PATCH] Create uci and ubus library symlink for backward
 compatibility of ezmesh

Change-Id: I24b178a1da97851d3826c3954bf11223f6ea6c6b
Signed-off-by: Deepak Kumar <deepaku@qti.qualcomm.com>
---
 package/system/ubus/Makefile | 1 +
 package/system/uci/Makefile  | 1 +
 2 files changed, 2 insertions(+)

diff --git a/package/system/ubus/Makefile b/package/system/ubus/Makefile
index 9a807852a250..8239f9c64891 100644
--- a/package/system/ubus/Makefile
+++ b/package/system/ubus/Makefile
@@ -70,6 +70,7 @@ endef
 define Package/libubus/install
 	$(INSTALL_DIR) $(1)/lib
 	$(CP) $(PKG_INSTALL_DIR)/usr/lib/libubus.so.* $(1)/lib/
+	ln -s $(PKG_INSTALL_DIR)/usr/lib/libubus.so.$(PKG_ABI_VERSION)  $(1)/lib/libubus.so.20231128
 endef
 
 define Package/libubus-lua/install
diff --git a/package/system/uci/Makefile b/package/system/uci/Makefile
index 6e4d8da97c75..18ce0e0b1b64 100644
--- a/package/system/uci/Makefile
+++ b/package/system/uci/Makefile
@@ -62,6 +62,7 @@ CMAKE_OPTIONS += \
 define Package/libuci/install
 	$(INSTALL_DIR) $(1)/lib
 	$(CP) $(PKG_BUILD_DIR)/libuci.so.* $(1)/lib/
+	ln -s $(PKG_BUILD_DIR)/libuci.so.$(PKG_ABI_VERSION) $(1)/lib/libuci.so
 endef
 
 define Package/libuci-lua/install
-- 
2.34.1

