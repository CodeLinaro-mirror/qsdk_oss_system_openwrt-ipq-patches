From dd8ff643e3962741b564e9ebd255afc368ba87ab Mon Sep 17 00:00:00 2001
From: Gunaal R <quic_gunar@quicinc.com>
Date: Tue, 17 Sep 2024 15:14:02 +0530
Subject: [PATCH] QSDK: CP: wifi-scripts: generate wireless config using
 mac80211.uc

Add changes in mac80211.uc and wifi-detect.uc to bring
up etc/config/wireless file.

wifi-detect.uc :

Bring in eht_cap and multi_radio idx along with freqs

mac80211.uc :

Added changes to bring etc/config/wireless in single wiphy
architecture and for spilt phy platforms.

Change-Id: Id76113f19eefa0530a624a7dea484829674cd3aa
Signed-off-by: Gunaal R <quic_gunar@quicinc.com>
---
 .../wifi-scripts/files/lib/wifi/mac80211.uc   | 160 +++++++++++++++---
 .../config/wifi-scripts/files/sbin/wifi       |   1 +
 .../files/usr/share/hostap/wifi-detect.uc     |  60 ++++++-
 3 files changed, 197 insertions(+), 24 deletions(-)

diff --git a/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc b/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
index e82525e247df..09b35965c1a7 100644
--- a/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
+++ b/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
@@ -11,9 +11,35 @@ if (!board.wlan)
 
 let idx = 0;
 let commit;
+let single_wiphy = false;
 
 let config = uci.cursor().get_all("wireless") ?? {};
 
+print(`set wireless.mac80211=smp_affinity
+set wireless.mac80211.enable_smp_affinity='1'
+set wireless.mac80211.enable_color='1'
+`);
+
+function freq_to_channel(freq) {
+	if (freq < 1000)
+		return 0;
+	if (freq == 2484)
+		return 14;
+	if (freq == 5935)
+		return 2;
+	if (freq < 2484)
+		return (freq - 2407) / 5;
+	if (freq >= 4910 && freq <= 4980)
+		return (freq - 4000) / 5;
+	if (freq < 5950)
+		return (freq - 5000) / 5;
+	if (freq <= 45000)
+		return (freq - 5950) / 5;
+	if (freq >= 58320 && freq <= 70200)
+		return (freq - 56160) / 2160;
+	return 0;
+}
+
 function radio_exists(path, macaddr, phy, radio) {
 	for (let name, s in config) {
 		if (s[".type"] != "wifi-device")
@@ -31,70 +57,116 @@ function radio_exists(path, macaddr, phy, radio) {
 	}
 }
 
-for (let phy_name, phy in board.wlan) {
-	let info = phy.info;
-	if (!info || !length(info.bands))
-		continue;
-
-	let radios = length(info.radios) > 0 ? info.radios : [{ bands: info.bands }];
-	for (let radio in radios) {
-		while (config[`radio${idx}`])
-			idx++;
-		let name = "radio" + idx;
+function get_band(freq) {
+	if (freq > 50000)
+		band_name = "60G";
+	else if (freq > 5900)
+		band_name = "6G";
+	else if (freq > 4000)
+		band_name = "5G";
+	else if (freq > 2000)
+		band_name = "2G";
+	return band_name;
+}
 
-		let s = "wireless." + name;
-		let si = "wireless.default_" + name;
+function get_channel_list(start_freq, end_freq) {
+	channels = freq_to_channel(start_freq) + "-" + freq_to_channel(end_freq);
+	return channels;
+}
 
-		let band_name = filter(bands_order, (b) => radio.bands[b])[0];
-		if (!band_name)
-			continue;
+function generate_config(info, name, single_wiphy, id, radio_idx) {
+	let s = "wireless." + name;
+	let si = "wireless.default_" + name;
 
-		let band = info.bands[band_name];
-		let rband = radio.bands[band_name];
-		let channel = rband.default_channel ?? "auto";
+	let band_name;
+	if (!single_wiphy) {
+		band_name = filter(bands_order, (b) => info.bands[b])[0];
+	} else {
+		let freq = radio_idx.first_freq;
+		band_name = get_band(freq);
+	}
 
-		let width = band.max_width;
-		if (band_name == "2G")
-			width = 20;
-		else if (width > 80)
-			width = 80;
+	if (!band_name)
+		return;
+
+	let band = info.bands[band_name];
+	let rband = radio.bands[band_name];
+	let channel = rband.default_channel;
+
+	if (single_wiphy) {
+		let start_freq = radio_idx.first_freq;
+		let end_freq = radio_idx.last_freq;
+		channels = get_channel_list(start_freq, end_freq);
+		if (band_name == "6G") {
+			let start_freq = radio_idx.first_freq;
+			if (freq_to_channel(start_freq) == 189)
+				channel = 197;
+			else
+				channel = 49;
+		}
+		if (band_name == "5G") {
+			let start_freq = radio_idx.first_freq;
+			if (freq_to_channel(start_freq) == 36)
+				channel = 36;
+			else
+				channel = 149;
+		}
+	} else {
+		if (band_name == "5G") {
+			if (band.default_channel == "100")
+				channel = 149;
+			else
+				channel = 36;
+		}
+		if (band_name == "6G") {
+			if (band.default_channel == "129")
+				channel = 197;
+			else
+				channel = 49;
+		}
+	}
 
-		let htmode = filter(htmode_order, (m) => band[lc(m)])[0];
-		if (htmode)
-			htmode += width;
-		else
-			htmode = "NOHT";
+	if (band_name == "2G")
+		channel = 6;
 
-		if (!phy.path)
-			continue;
 
-		let macaddr = trim(readfile(`/sys/class/ieee80211/${phy_name}/macaddress`));
-		if (radio_exists(phy.path, macaddr, phy_name, radio.index))
-			continue;
+	let width = band.max_width;
+	if (band_name == "2G")
+		width = 20;
+	else if (width > 80)
+		width = 80;
 
-		let id = `phy='${phy_name}'`;
-		if (match(phy_name, /^phy[0-9]/))
-			id = `path='${phy.path}'`;
+	let htmode = filter(htmode_order, (m) => band[lc(m)])[0];
+	if (htmode)
+		htmode += width;
+	else
+		htmode = "NOHT";
 
-		band_name = lc(band_name);
+	band_name = lc(band_name);
 
-		let country, defaults, num_global_macaddr;
-		if (board.wlan.defaults) {
-			defaults = board.wlan.defaults.ssids?.[band_name]?.ssid ? board.wlan.defaults.ssids?.[band_name] : board.wlan.defaults.ssids?.all;
-			country = board.wlan.defaults.country;
-			if (!country && band_name != '2g')
-				defaults = null;
-			num_global_macaddr = board.wlan.defaults.ssids?.[band_name]?.mac_count;
-		}
+	let country, defaults, num_global_macaddr;
+	if (board.wlan.defaults) {
+		defaults = board.wlan.defaults.ssids?.[band_name]?.ssid ? board.wlan.defaults.ssids?.[band_name] : board.wlan.defaults.ssids?.all;
+		country = board.wlan.defaults.country;
+		if (!country && band_name != '2g')
+			defaults = null;
+		num_global_macaddr = board.wlan.defaults.ssids?.[band_name]?.mac_count;
+	}
 
-		if (length(info.radios) > 0)
-			id += `\nset ${s}.radio='${radio.index}'`;
+	if (length(info.radios) > 0)
+		id += `\nset ${s}.radio='${radio.index}'`;
 
-		print(`set ${s}=wifi-device
+	print(`set ${s}=wifi-device
 set ${s}.type='mac80211'
 set ${s}.${id}
 set ${s}.band='${band_name}'
 set ${s}.channel='${channel}'
+`);
+
+if (channels)
+	print(`set ${s}.channels='${channels}'`);
+
+print(`
 set ${s}.htmode='${htmode}'
 set ${s}.country='${country || ''}'
 set ${s}.num_global_macaddr='${num_global_macaddr || ''}'
@@ -109,9 +181,50 @@ set ${si}.encryption='${defaults?.encryption || "none"}'
 set ${si}.key='${defaults?.key || ""}'
 
 `);
-		config[name] = {};
-		commit = true;
+	if (band_name == "6G") {
+		print(`set ${si}.encryption='sae'
+		set ${si}.sae_pwe='1'
+		set ${si}.key='0123456789'
+`);
+	}
+}
+
+for (let phy_name, phy in board.wlan) {
+	let info = phy.info;
+	let name;
+	if (!info || !length(info.bands))
+		continue;
+
+	if (!phy.path)
+		return;
+
+	let macaddr = trim(readfile(`/sys/class/ieee80211/${phy_name}/macaddress`));
+	if (radio_exists(phy.path, macaddr, phy_name))
+		return;
+
+	id = `phy='${phy_name}'`;
+	if (match(phy_name, /^phy[0-9]/))
+	id = `path='${phy.path}'`;
+
+	if (phy.multi_radio)
+		single_wiphy = true;
+
+	if (single_wiphy) {
+		let multi_radio = phy.multi_radio;
+		let hw_idx;
+		for (let radio_name in multi_radio ) {
+			let radio_idx = multi_radio[radio_name];
+			name = "radio" + idx + "_band" + hw_idx++;
+			generate_config(info, name, single_wiphy, id, radio_idx);
+		}
+	} else {
+		while (config[`radio${idx}`])
+			idx++;
+		name = "radio" + idx++;
+		generate_config(info, name, single_wiphy, id, NULL);
 	}
+	config[name] = {};
+	commit = true;
 }
 
 if (commit)
diff --git a/package/network/config/wifi-scripts/files/sbin/wifi b/package/network/config/wifi-scripts/files/sbin/wifi
index 35592ea3c7b9..11d1f964d35f 100755
--- a/package/network/config/wifi-scripts/files/sbin/wifi
+++ b/package/network/config/wifi-scripts/files/sbin/wifi
@@ -199,6 +199,7 @@ wifi_detect_notice() {
 
 wifi_config() {
 	pre_wifi_config
+	ucode /usr/share/hostap/wifi-detect.uc
 	[ ! -f /etc/config/wireless ] && touch /etc/config/wireless
 	ucode /lib/wifi/mac80211.uc | uci -q batch
 
diff --git a/package/network/config/wifi-scripts/files/usr/share/hostap/wifi-detect.uc b/package/network/config/wifi-scripts/files/usr/share/hostap/wifi-detect.uc
index db862d40c2a9..1decdeb24eeb 100644
--- a/package/network/config/wifi-scripts/files/usr/share/hostap/wifi-detect.uc
+++ b/package/network/config/wifi-scripts/files/usr/share/hostap/wifi-detect.uc
@@ -99,6 +99,9 @@ function wiphy_detect() {
 			bands: {},
 			radios: []
 		};
+		let multi_radio = {};
+		let start_freq_list = [];
+		let end_freq_list = [];
 
 		for (let radio in phy.radios) {
 			// S1G is not supported yet
@@ -157,7 +160,10 @@ function wiphy_detect() {
 				eht_phy_cap |= ift.eht_cap_phy[0];
 			}
 
-			if (band_name != "2G" &&
+			if (band_name == "6G" &&
+				(eht_phy_cap & 0x2))
+				band_info.max_width = 320;
+			else if (band_name != "2G" &&
 			    (he_phy_cap & 0x18) || ((band.vht_capa >> 2) & 0x3))
 				band_info.max_width = 160;
 			else if (band_name != "2G" &&
@@ -240,9 +246,36 @@ function wiphy_detect() {
 			if (eht_phy_cap & 2)
 				push(modes, "EHT320");
 		}
+		if (phy.radios) {
+			let radios = phy.radios;
+			for (let i=0; i< length(radios) ; i++) {
+				let range = radios[i];
+				for (let j=0; j < length(range.freq_ranges); j++) {
+					let freq_range = range.freq_ranges[j];
+					let start_freq = (range.freq_ranges[0]["start"] / 1000) + 10;
+					let end_freq = (range.freq_ranges[0]["end"] / 1000) - 10;
+					start_freq_list[i] = start_freq;
+					end_freq_list[i] = end_freq;
+				}
+			}
+			let first_freq = sort(start_freq_list);
+			let last_freq = sort(end_freq_list);
+
+			for (let i=0; i < length(phy.radios); i++){
+				let radio_name = "radio" + i;
+				multi_radio[radio_name] = {
+					"idx" : i,
+					"first_freq" : first_freq[i],
+					"last_freq" : last_freq[i]
+				};
+			}
+		}
 
 		let entry = wiphy_get_entry(name, path);
 		entry.info = info;
+		if (phy.radios) {
+			entry.multi_radio = multi_radio;
+		}
 	}
 }
 
-- 
2.34.1

