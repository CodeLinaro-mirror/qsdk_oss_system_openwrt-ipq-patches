From 34765d21097ea88fc3f15fec6d511d929d31ba4a Mon Sep 17 00:00:00 2001
From: Deepak Kumar <quic_deepaku@quicinc.com>
Date: Tue, 2 Jul 2024 18:30:05 +0530
Subject: [PATCH] adding default value for packet_steering

Change-Id: I9360a276d4d974e699b1e2129adcccef2303fc70
Signed-off-by: Deepak Kumar <quic_deepaku@quicinc.com>
(cherry picked from commit 2f1e0fc93ec4c8113ce2d18bdbbdae42a1bf4b2b)
---
 package/base-files/files/bin/config_generate | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/package/base-files/files/bin/config_generate b/package/base-files/files/bin/config_generate
index be21d0079a8a..d27e4d08f512 100755
--- a/package/base-files/files/bin/config_generate
+++ b/package/base-files/files/bin/config_generate
@@ -45,13 +45,19 @@ generate_static_network() {
 		set network.loopback.ipaddr='127.0.0.1'
 		set network.loopback.netmask='255.0.0.0'
 	EOF
-		[ -e /proc/sys/net/ipv6 ] && {
-			uci -q batch <<-EOF
-				delete network.globals
-				set network.globals='globals'
-				set network.globals.ula_prefix='auto'
-			EOF
-		}
+
+	uci -q batch <<-EOF
+		delete network.globals
+		set network.globals='globals'
+		set network.globals.packet_steering='0'
+		set network.globals.steering_flows='0'
+	EOF
+
+	[ -e /proc/sys/net/ipv6 ] && {
+		uci -q batch <<-EOF
+			set network.globals.ula_prefix='auto'
+		EOF
+	}
 
 	if json_is_a dsl object; then
 		json_select dsl
-- 
